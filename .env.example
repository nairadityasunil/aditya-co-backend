PORT=5000
MONGODB_URI=mongodb://localhost:27017/aditya_co
JWT_SECRET=change_me_to_a_long_random_string_of_32_or_more_characters
JWT_EXPIRES_IN=7d
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://adityaco.co.in
NODE_ENV=development

# First-run admin (used by `npm run seed`; you are forced to change it on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aditya_co

# Email (Brevo). Without BREVO_API_KEY enquiries are still saved but no email is sent.
BREVO_API_KEY=
# A sender verified in Brevo, ideally on your authenticated domain
EMAIL_FROM=info@adityaco.co.in
EMAIL_FROM_NAME=Aditya & Co.
# Inbox(es) that receive new website enquiries (comma separated)
CONTACT_EMAIL=info@adityaco.co.in
WEBSITE_URL=https://adityaco.co.in
